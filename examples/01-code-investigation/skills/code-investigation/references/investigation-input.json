{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-investigation/input-v1",
  "type": "object",
  "required": [
    "question",
    "path",
    "snapshot"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "id",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

_io := "ionice -c 3"
_target := "/ssd/mirror-rootfs" + justfile_directory() + "/target"

_guard:
    test -L target
    test "$(readlink target)" = "{{_target}}"

lock: _guard
    {{_io}} cargo +1.98.0 generate-lockfile

build: _guard
    {{_io}} cargo +1.98.0 build --locked

run: build
    {{_io}} cargo +1.98.0 run --locked -- "{{justfile_directory()}}" "{{env_var('ISSUE_269_TMPDIR')}}"

acceptance: run

fmt:
    {{_io}} cargo +1.98.0 fmt -- --check

lint: _guard
    {{_io}} cargo +1.98.0 clippy --locked -- -D warnings

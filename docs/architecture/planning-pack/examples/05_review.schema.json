{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/review-v1.json",
  "title": "Workflow Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "defects", "confidence"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "revise", "abstain"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "defects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error", "critical"]
          },
          "location": {
            "type": ["string", "null"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "suggested_action": {
            "type": ["string", "null"],
            "maxLength": 4000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {
        "properties": {
          "defects": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {"enum": ["error", "critical"]}
                },
                "required": ["severity"]
              }
            }
          }
        }
      }
    }
  ]
}
